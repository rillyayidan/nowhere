# Local server
PORT=8080
CORS_ORIGINS=http://localhost:5173
FRONTEND_DIST_DIR=frontend/dist

# Local fallback mode.
# true: app still returns demo recommendations if Vertex AI or Places is unavailable.
# false: API returns an error when production integrations fail.
NOWHERE_ALLOW_DEMO_FALLBACK=true

# Vertex AI Gemini
# Cloud Run uses its service account automatically; no service account JSON is needed.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Maps Platform / Places API New
GOOGLE_MAPS_KEY=

# Firestore / Firebase project used for feedback storage.
FIREBASE_PROJECT_ID=your-google-cloud-project-id

# Optional local-only auth helper for Vertex/Firestore REST calls.
# Generate with: gcloud auth print-access-token
# Do not set this on Cloud Run.
GOOGLE_OAUTH_ACCESS_TOKEN=
